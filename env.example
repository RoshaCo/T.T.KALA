# =========================================================
# T.T.KALAA - تنظیمات نمونه Backend
# =========================================================
# این فایل فقط نمونه است.
# مقادیر واقعی را داخل فایل .env قرار دهید.
# فایل .env واقعی را هرگز در GitHub قرار ندهید.
# =========================================================

# -------------------------
# Server
# -------------------------

PORT=3000

# آدرس اصلی سایت
FRONTEND_URL=https://ttkalaa.ir


# -------------------------
# PostgreSQL Database
# -------------------------

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME

# در صورت استفاده از SSL دیتابیس
DATABASE_SSL=false


# -------------------------
# ZarinPal
# -------------------------

# Merchant ID واقعی زرین‌پال
ZARINPAL_MERCHANT_ID=YOUR_ZARINPAL_MERCHANT_ID

# true = Sandbox
# false = پرداخت واقعی
ZARINPAL_SANDBOX=false

# آدرس بازگشت از درگاه
ZARINPAL_CALLBACK_URL=https://ttkalaa.ir/payment-callback


# -------------------------
# محصولات
# -------------------------

# قیمت هر محصول به تومان
PRODUCT_PRICE_TOMAN=29000

# قیمت هر محصول برای ارسال به زرین‌پال
# زرین‌پال مبلغ را به ریال دریافت می‌کند.
PRODUCT_PRICE_RIAL=290000


# -------------------------
# قرعه‌کشی
# -------------------------

# نسبت جایزه
PRIZE_RATIO=100

# هر خرید موفق = یک شانس
CHANCE_PER_PURCHASE=1


# -------------------------
# امنیت
# -------------------------

# یک مقدار تصادفی و طولانی برای امنیت Session/Tokenها
# مقدار واقعی را خودتان تولید کنید.
APP_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET


# -------------------------
# لینک دانلود
# -------------------------

# مدت اعتبار لینک دانلود به ثانیه
DOWNLOAD_LINK_TTL=900
